# Скопируйте в .env (локально) или задайте эти переменные в панели bothost
TELEGRAM_BOT_TOKEN=токен_от_BotFather
API_KEY=ваш_ключ_agentrouter
API_BASE_URL=https://agentrouter.org/v1
# Модель (gpt-5.6-sol, gpt-6.1-sol, gpt-6-astra)
CHAT_MODEL=gpt-5.6-sol


# Необязательно: id пользователей Telegram через запятую, кому разрешён доступ
ALLOWED_USERS=
